# Storage
CONTINUUM_DB_PATH=./data/continuum.db
CONTINUUM_LIBRARY_DIR=./data/books
CONTINUUM_LIBRARY_MAX_BOOKS=3
CONTINUUM_LIBRARY_WORKERS=4

# Provider selection: hashing is deterministic and offline; openai is semantic.
CONTINUUM_EMBEDDING_PROVIDER=hashing
CONTINUUM_EMBEDDING_MODEL=text-embedding-3-small
CONTINUUM_EMBEDDING_DIMENSIONS=512
CONTINUUM_CONSOLIDATION_MODEL=gpt-5.6

# Retrieval uses adaptive exact scanning for semantic-only queries by default.
# Per-query modes are also available through the CLI and JSON API.

# Set OPENAI_API_KEY in a private .env.local file outside source control.
