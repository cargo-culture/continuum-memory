# Storage
CONTINUUM_DB_PATH=./data/continuum.db
CONTINUUM_LIBRARY_DIR=./data/books
CONTINUUM_LIBRARY_MAX_BOOKS=3
CONTINUUM_LIBRARY_WORKERS=4

# Provider selection: hashing is deterministic and offline; openai is semantic.
CONTINUUM_EMBEDDING_PROVIDER=hashing
CONTINUUM_EMBEDDING_MODEL=text-embedding-3-small
CONTINUUM_EMBEDDING_DIMENSIONS=512
CONTINUUM_CONSOLIDATION_MODEL=gpt-5.6

# Local MCP identity. Authenticated HTTP ignores this value and derives an
# opaque namespace from the verified OAuth issuer and subject.
CONTINUUM_NAMESPACE=local

# Authenticated Streamable HTTP / ChatGPT deployment
# CONTINUUM_MCP_ISSUER_URL=https://auth.example.com/
# CONTINUUM_MCP_RESOURCE_URL=https://memory.example.com/mcp
# CONTINUUM_MCP_INTROSPECTION_URL=https://auth.example.com/oauth/introspect
# CONTINUUM_MCP_INTROSPECTION_CLIENT_ID=continuum-resource-server
# CONTINUUM_MCP_INTROSPECTION_CLIENT_SECRET=replace-me
# Exact token issued by the OpenAI plugin submission portal for domain verification.
# CONTINUUM_OPENAI_CHALLENGE_TOKEN=replace-with-portal-token

# Retrieval uses adaptive exact scanning for semantic-only queries by default.
# Per-query modes are also available through the CLI and JSON API.

# Set OPENAI_API_KEY in a private .env.local file outside source control.
